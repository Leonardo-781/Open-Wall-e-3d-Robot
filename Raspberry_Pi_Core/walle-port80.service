[Unit]
Description=WALL-E Port 80 to 5000 Redirect
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/iptables -t nat -A PREROUTING -p tcp --dport 80 -j REDIRECT --to-ports 5000
ExecStart=/sbin/iptables -t nat -A OUTPUT -p tcp -o lo --dport 80 -j REDIRECT --to-ports 5000

[Install]
WantedBy=multi-user.target
